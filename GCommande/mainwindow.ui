  <property name="styleSheet"><string notr="true">* { font-family: "Segoe UI", sans-serif; font-size: 9pt; }
QMainWindow, QWidget#centralwidget, QStackedWidget, QWidget#page_5, QWidget#page_6 { background-color: #F3F6F9; }
QLabel { background: transparent; color: #1F2937; }

QFrame#frameSidebar { background-color: #0B5D63; border: none; }
QFrame#frameSidebar QPushButton { background-color: transparent; color: #E6F4F3; border: none; border-radius: 6px; text-align: left; padding-left: 8px; font-size: 9pt; }
QFrame#frameSidebar QPushButton:hover { background-color: rgba(255,255,255,0.14); }
QFrame#frameSidebar QPushButton#btnCommande { background-color: #137A80; color: white; font-weight: bold; }

QLabel#label_titre { color: #0F2A43; font-size: 16pt; font-weight: bold; }
QLabel#label_soustitre { color: #6B7280; }

QLineEdit, QComboBox { background-color: white; color: #1F2937; border: 1px solid #D1D5DB; border-radius: 6px; padding: 1px 8px; selection-background-color: #0F766E; }
QLineEdit:focus, QComboBox:focus { border: 1px solid #0F766E; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView { background: white; color: #1F2937; border: 1px solid #D1D5DB; selection-background-color: #E6F4F3; selection-color: #0B5D63; }

QPushButton#btnAjouter, QPushButton#btnEnregistrer, QPushButton#btnExporter { background-color: #0F766E; color: white; border: none; border-radius: 6px; font-weight: bold; }
QPushButton#btnAjouter:hover, QPushButton#btnEnregistrer:hover, QPushButton#btnExporter:hover { background-color: #0B5D63; }
QPushButton#btnModifier, QPushButton#btnSupprimer { border: none; border-radius: 5px; color: white; font-weight: bold; min-width: 22px; max-width: 22px; min-height: 22px; max-height: 22px; }
QPushButton#btnModifier { background-color: #0F766E; }
QPushButton#btnSupprimer { background-color: #DC2626; }

QTableWidget { background-color: white; color: #1F2937; border: 1px solid #E5E7EB; border-radius: 10px; selection-background-color: #E6F4F3; selection-color: #0B5D63; }
QTableWidget::item { padding-left: 6px; border-bottom: 1px solid #EEF2F6; }
QHeaderView::section { background-color: #F8FAFC; color: #374151; border: none; border-bottom: 1px solid #E5E7EB; padding: 6px; font-weight: bold; }
QWidget#cellContainer { background: transparent; }
QLabel#badgeCommandee, QLabel#label_val_3 { background-color: #DBEAFE; color: #1D4ED8; border-radius: 9px; font-weight: bold; }

QFrame#frame_ajout, QFrame#frame_details, QFrame#frame_freq, QFrame#frame_prev { background-color: white; border: 1px solid #E5E7EB; border-radius: 10px; }
QFrame#frame_ajout QLabel, QFrame#frame_details QLabel, QFrame#frame_freq QLabel, QFrame#frame_prev QLabel { border: none; }
QLabel#label_titre_ajout, QLabel#label_titre_details, QLabel#label_titre_freq, QLabel#label_titre_prev { background-color: #0F766E; color: white; font-weight: bold; padding-left: 10px; border-top-left-radius: 9px; border-top-right-radius: 9px; }
QLabel#label_cle_0, QLabel#label_cle_1, QLabel#label_cle_2, QLabel#label_cle_3, QLabel#label_cle_4 { color: #6B7280; }
QLabel#label_val_0, QLabel#label_val_1, QLabel#label_val_2, QLabel#label_val_4 { color: #111827; font-weight: bold; }
QLabel#label_graph_freq, QLabel#label_graph_prev { background-color: #F3F6F9; color: #9CA3AF; border-radius: 8px; }

QPushButton#btnFrequence, QPushButton#btnPrevision { background-color: white; color: #0F766E; border: 1px solid #0F766E; border-radius: 6px; font-weight: bold; }
QPushButton#btnFrequence:hover, QPushButton#btnPrevision:hover { background-color: #E6F4F3; }
QPushButton#btnFrequence:pressed, QPushButton#btnPrevision:pressed { background-color: #CDE9E7; }
</string></property>
